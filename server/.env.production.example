# Entorno de producción
NODE_ENV=production
PORT=4000

# Seguridad y Autenticación
JWT_SECRET=reemplazar-con-secreto-aleatorio-seguro-minimo-32-caracteres
ADMIN_EMAIL=admin@manubarber.cl
ADMIN_PASSWORD=contrasena-larga-y-robusta-para-admin

# Orígenes Frontend permitidos para CORS (separados por coma)
FRONTEND_ORIGIN=https://manubarber.cl,https://www.manubarber.cl,https://manubarber.vercel.app

# URLs públicas
API_PUBLIC_URL=https://api.manubarber.cl
WEB_PUBLIC_URL=https://manubarber.cl

# Pasarela de pagos Flow (Sandbox o Producción)
# En producción: https://www.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://www.flow.cl/api

# Zona horaria y duración de reservas
BOOKING_TIMEZONE=America/Santiago
BOOKING_DEFAULT_DURATION_MINUTES=60
BOOKING_SLOT_INTERVAL_MINUTES=30
