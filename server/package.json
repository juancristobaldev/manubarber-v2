    "test:booking": "tsx test/booking.integration.ts",
    "test:booking-contract": "tsx test/graphql-contract.ts",
    "test:admin": "tsx test/admin.integration.ts",
    "test:json-db": "tsx test/json-db.test.ts",
    "test:audit": "tsx test/full-coherence-audit.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^11.0.0",
