# PostgreSQL local or managed. Never commit the real value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manubarber?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
ADMIN_EMAIL="admin@manubarber.cl"
ADMIN_PASSWORD="use-a-unique-long-password"
# Flow credentials must remain on the API server. Use sandbox first.
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_API_URL="https://sandbox.flow.cl/api"
# Public HTTPS API origin reachable by Flow, and public web origin.
API_PUBLIC_URL="https://your-api.example.com"
WEB_PUBLIC_URL="http://localhost:3000"
# Directorio local persistente para almacenamiento de imágenes subidas (uploads)
UPLOAD_DIR="./uploads"
BOOKING_TIMEZONE="America/Santiago"
BOOKING_DEFAULT_DURATION_MINUTES=60
BOOKING_SLOT_INTERVAL_MINUTES=30
