# URL de GraphQL en producción (ej. https://api.manubarber.cl/graphql o https://manubarber-api.vercel.app/graphql)
NEXT_PUBLIC_GRAPHQL_URL=https://api.manubarber.cl/graphql

# URL base de la API para endpoints REST y subidas de imágenes (/uploads)
NEXT_PUBLIC_API_URL=https://api.manubarber.cl

# Proxy opcional si se desea redirigir /uploads a través del dominio de Next.js
# API_PROXY_URL=https://api.manubarber.cl
